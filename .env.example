# ─────────────────────────────────────────────────────────────────────────────
#  ZEUS — Environment Variables Template
#  Copy this file to .env and fill in your values:
#    cp .env.example .env
#
#  ⚠  Never commit .env to git — it is already listed in .gitignore
# ─────────────────────────────────────────────────────────────────────────────


# ── Database ──────────────────────────────────────────────────────────────────
# Password for the PostgreSQL zeus user
POSTGRES_PASSWORD=zeuspassword

# Port on the HOST machine that maps to postgres:5432 (avoid 5432 if already in use)
POSTGRES_PORT=5433

# Full connection string (used by the backend)
# Docker Compose sets this automatically — only override if running without Docker
# DATABASE_URL=postgresql://zeus:zeuspassword@localhost:5433/zeus


# ── Security ──────────────────────────────────────────────────────────────────
# JWT signing secret — CHANGE THIS TO A LONG RANDOM STRING IN PRODUCTION!
# Generate one with:  python -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=zeus-change-this-secret-in-production


# ── Admin Account ─────────────────────────────────────────────────────────────
# Auto-created on first startup. Password is re-synced from env on every startup.
ADMIN_EMAIL=admin@zeus.local
ADMIN_PASSWORD=changeme123


# ── AI Providers (at least one recommended — Pollinations is free fallback) ───

# Groq Cloud — fastest free tier (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (https://aistudio.google.com)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# OpenRouter — free-tier models (https://openrouter.ai/keys)
# Per-task routing sends understanding tasks here; 50 req/day on free accounts.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# OpenAI (https://platform.openai.com)
OPENAI_API_KEY=

# HuggingFace Inference API (https://huggingface.co/settings/tokens)
HF_TOKEN=
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct

# Active AI provider: auto | groq | gemini | openai | hf | pollinations
# auto = tries providers in order: Groq -> Gemini -> HF -> OpenAI -> Pollinations
ACTIVE_AI_PROVIDER=auto


# ── YouTube Data API ──────────────────────────────────────────────────────────
# Required for video search, duration calculation, and study time estimates.
# Get a free key: console.cloud.google.com -> YouTube Data API v3 -> Enable -> Credentials
YOUTUBE_API_KEY=


# ── Application ───────────────────────────────────────────────────────────────
# Port on the HOST that maps to the ZEUS app (port 8000 inside container)
APP_PORT=8000

# CORS allowed origins (comma-separated; add your domain in production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://yourdomain.com


# ── Google OAuth & Frontend URL ──────────────────────────────────────────────
# Needed for "Sign in with Google" flow
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
FRONTEND_URL=http://localhost:8000
