DATABASE_URL=postgresql://zeus:zeus@localhost:5433/zeus
# SQLite fallback disabled - Postgres required (docker compose up -d postgres)
USE_SQLITE_FALLBACK=false

# Auth token signing (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-long-random-value

# YouTube Data API v3 (console.cloud.google.com → YouTube Data API v3 → key)
# Used for video search + view/like quality ranking. Scraping fallback if empty.
YOUTUBE_API_KEY=

# LLM — ضع واحد فقط، الأولوية: Groq (مجاني سريع) > Gemini > OpenAI > Mock
# Groq مجاني: https://console.groq.com → Create API Key (لا يحتاج بطاقة)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# Gemini مجاني: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-flash

# OpenAI (مدفوع)
OPENAI_API_KEY=sk-...

# Pollinations لم يعد مجاني بالكامل - يُستخدم كـ fallback فقط
